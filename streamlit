def kpi_card(tabela_resultados, default):
    if default == "dark":
        classes = "card-dark"
    elif default == "fade":
        classes = "card-fade"
    else:
        classes = "card"
    return f"""
    <div class = "{classes}'>
        <h2>{tabela_resultados["titulo"]}</h2>
        <div class="kpi-value"> {tabela_resultados["valor"]}</div>
        <p>{tabela_resultados["delta"]}</p>
    </div>
    """

def drop_arquivo(drop_titulo, default):
    if default == "dark":
        classes = "card-dark"
    elif default == "fade":
        classes = "card-fade"
    else:
        classes = "card"
    uploaded_files = st.file_uploader(
        "Subir Arquivo", accept_multiple_files=True, type="csv"
    )
    for uploaded_file in uploaded_files:
        df = pd.read_csv(uploaded_file)
        st.write(df)
    return f"""
    <div class = "{classes}'>
        <h2>{tabela_resultados["titulo"]}</h2>
        <div class="kpi-value"> {tabela_resultados["valor"]}</div>
        <p>{tabela_resultados["delta"]}</p>
    </div>
    """

